# Cabeceras HTTP de Cloudflare Pages (entorno de pruebas de la 3.0). GitHub Pages ignora este archivo.
# La app es un único HTML con scripts y estilos en línea; solo se conecta a sí misma y a Supabase.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Que los dispositivos pregunten siempre por la versión nueva de la app y su configuración
/sw.js
  Cache-Control: no-cache
/config-nube.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
